# Copy to .env and fill in. .env is gitignored - never commit real keys.
# Everything here is OPTIONAL: notebooks 01-05 run without any of it.

# Only needed for src/llm_baseline.py, the optional LLM few-shot experiment.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# Only needed if you prefer env vars over ~/.kaggle/kaggle.json for the dataset
# download (src/data.py). Get these from your Kaggle account settings.
# KAGGLE_USERNAME=your_username
# KAGGLE_KEY=your_api_key
