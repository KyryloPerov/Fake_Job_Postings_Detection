# --- data: downloaded from Kaggle, regenerated by src/preprocessing.py ------
data/*
!data/raw/
!data/processed/
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# --- trained models and cached embeddings ----------------------------------
models/*
!models/.gitkeep

# --- figures are regenerated by the notebooks; the experiment log is tracked -
reports/figures/*
!reports/figures/.gitkeep

# --- secrets ---------------------------------------------------------------
.env
.env.local
*.key
kaggle.json

# --- python ----------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.python-version

# --- notebooks -------------------------------------------------------------
.ipynb_checkpoints/
*-checkpoint.ipynb

# --- huggingface / torch caches --------------------------------------------
.cache/
checkpoints/
runs/
wandb/

# --- editors and OS --------------------------------------------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
